# Start the .NET API for authentication, including when using demo data.
TDMS_DATA_SOURCE=demo
TDMS_API_BASE_URL=http://localhost:5043
TDMS_LOGIN_EMAIL=admin@tdms.local
TDMS_LOGIN_PASSWORD=TdmsDemo!2026
# Set these same initial-account values in the API process environment.
# Once provisioned, password changes are stored in SQL Server; changing these
# environment values does not reset an existing account password.
# REQUIRED in production: at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TDMS_SESSION_SECRET=
